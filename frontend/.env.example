# Whether to use built-in Mock data (false sends requests to real backend /api/v1).
# Development mode defaults to true; production build (vite build) defaults to false.
VITE_USE_MOCK=false

# Backend API base URL. Leave empty or remove to use same-origin relative path /api/v1 (local Vite proxy).
# When deploying to an independent domain, provide the full URL, for example:
# VITE_API_BASE_URL=https://addressbook-api.onrender.com/api/v1
VITE_API_BASE_URL=
